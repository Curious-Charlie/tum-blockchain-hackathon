# Shared keys for every app. Copy to .env and fill in; never commit the real values.

# Cardano preprod chain access (https://blockfrost.io, free plan is enough)
BLOCKFROST_PROJECT_ID=

# Claude (https://console.anthropic.com). Answers are cached on disk, so reruns cost nothing.
ANTHROPIC_API_KEY=

# Only for `npm run smoke` / `npm run publish-test` and as the treasury of `npm run wallets -- --fund`:
# created by `npm run wallets` in cardano/.
BUYER_MNEMONIC=
SELLER_MNEMONIC=
