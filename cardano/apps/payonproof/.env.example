# D1 PayOnProof: conditional payment keeper
# Wallet mnemonics: created by `npm run wallets -w apps/payonproof`. Never commit real values.
LENA_MNEMONIC=
KEEPER_MNEMONIC=

# BLOCKFROST_PROJECT_ID and ANTHROPIC_API_KEY come from cardano/.env.
# The Keeper's EVM side (Base Sepolia invoice escrow) reads api3/.env: PRIVATE_KEY, PAYER_PRIVATE_KEY, RPC_URL.
