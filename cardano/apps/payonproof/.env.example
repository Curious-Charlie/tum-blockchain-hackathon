# D1 PayOnProof: Lena's finance agent and three Keepers
# Wallet mnemonics: created by `npm run wallets -w apps/payonproof`. Never commit real values.
LENA_MNEMONIC=
KEEPER_MNEMONIC=
KEEPER_B_MNEMONIC=
KEEPER_C_MNEMONIC=
# Each Keeper's EVM account (gas for InvoiceEscrow.execute). Created on first use.
KEEPER_EVM_PRIVATE_KEY=
KEEPER_B_EVM_PRIVATE_KEY=
KEEPER_C_EVM_PRIVATE_KEY=
# Optional: force the EVM side (default: base-sepolia if deployments.json has an escrow, else a local anvil)
# EVM_NETWORK=anvil

# BLOCKFROST_PROJECT_ID and ANTHROPIC_API_KEY come from cardano/.env.
# Lena's EVM treasury and RPC_URL come from api3/.env (PRIVATE_KEY, RPC_URL).
